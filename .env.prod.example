# =============================================================
# Production environment example
# Copy to .env.prod and fill in all required values
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# NOTE: DATABASE_URL and REDIS_URL are NOT set here — they are
#       constructed automatically in docker-compose.prod.yml using
#       Docker-internal hostnames (postgres, redis).
# =============================================================

# --- JWT ---
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (credentials only; URL is built in docker-compose) ---
POSTGRES_USER=crm
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=crm_db

# --- Redis (password only; URL is built in docker-compose) ---
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# --- Telegram Bot ---
BOT_TOKEN=REPLACE_WITH_BOT_TOKEN_FROM_BOTFATHER
WEBHOOK_URL=https://example.com/api/v1/telegram/webhook
INTERNAL_BOT_TOKEN=REPLACE_WITH_64_CHAR_RANDOM_STRING

# Optional: proxy for Telegram API (HTTP or SOCKS5)
# TELEGRAM_PROXY=socks5://user:pass@host:1080

# --- CORS ---
CORS_ORIGINS=["https://example.com"]

# --- Superadmin (created on first startup) ---
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
