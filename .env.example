# =============================================================
# Dev environment example — copy to .env and fill in values
# NOTE: DATABASE_URL and REDIS_URL use localhost for local dev
#       (without Docker). When running via docker-compose, these
#       are automatically overridden with Docker-internal hostnames.
# =============================================================

# Application
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development

# Database (localhost = local dev; Docker overrides this to postgres:5432)
DATABASE_URL=postgresql+asyncpg://crm:crm_secret@localhost:5432/crm_db

# Redis (localhost = local dev; Docker overrides this to redis:6379)
REDIS_URL=redis://localhost:6379/0

# Telegram Bot
BOT_TOKEN=your-telegram-bot-token
WEBHOOK_URL=https://yourdomain.com/api/v1/telegram/webhook
INTERNAL_BOT_TOKEN=your-internal-bot-token-min-32-chars

# Optional: proxy for Telegram API (HTTP or SOCKS5)
# TELEGRAM_PROXY=socks5://user:pass@host:1080

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# First superadmin (created on startup if no users exist)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=Admin123!
